{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HTML Note",
  "version": "0.1.0",
  "identifier": "com.htmlnote.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HTML Note",
        "width": 1360,
        "height": 900,
        "minWidth": 820,
        "minHeight": 560,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML document",
        "description": "HTML-документ",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installMode": "currentUser"
      }
    }
  }
}
